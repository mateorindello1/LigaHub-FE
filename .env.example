# Copiar este archivo como .env y completar los valores.
# Vite solo expone al código las variables que empiezan con VITE_ (import.meta.env.VITE_...).
# Todo lo que se pone acá termina en el JavaScript que descarga el navegador: no poner secretos.

# URL base de la API (backend LigaHub-BE).
VITE_API_URL=http://localhost:3000

# Clave de licencia de Syncfusion (https://www.syncfusion.com/account/claim-license-key).
# Sin clave, Syncfusion muestra un aviso de licencia en pantalla.
VITE_SYNCFUSION_LICENSE=
